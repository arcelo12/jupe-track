JUNOS_HOST=192.168.1.1
JUNOS_USER=admin
JUNOS_PASS=your_junos_password
JUNOS_PORT=830

# ── Authentication ──────────────────────────────────────────────────────────
# IMPORTANT: Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin (random on first startup if empty; printed to log once)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: base64 SSH host key for NETCONF verification. If unset, host key is NOT verified (insecure).
JUNOS_HOST_KEY=

# Optional: protect the /api/v1/auth/init endpoint with a one-time secret
INIT_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Options: sqlite (default) | mysql
DB_TYPE=sqlite

# MySQL config (only used if DB_TYPE=mysql)
# MYSQL_USER=jupetrack
# MYSQL_PASSWORD=jupetrack_pass
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DB=jupetrack
