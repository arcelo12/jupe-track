JUNOS_HOST=192.168.1.1
JUNOS_USER=admin
JUNOS_PASS=your_junos_password
JUNOS_PORT=830

# ── Authentication ──────────────────────────────────────────────────────────
# IMPORTANT: Change SECRET_KEY to a random 64-char string in production!
SECRET_KEY=change-this-secret-key-to-random-64-chars-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin account (auto-created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SecurePassword123!

# Optional: protect the /api/v1/auth/init endpoint with a one-time secret
INIT_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Options: sqlite (default) | mysql
DB_TYPE=sqlite

# MySQL config (only used if DB_TYPE=mysql)
# MYSQL_USER=jupetrack
# MYSQL_PASSWORD=jupetrack_pass
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DB=jupetrack
