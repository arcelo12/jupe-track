# ==============================================================================
# JupeTrack v2.0 - Environment Configuration
# ==============================================================================

# ── Juniper Device Configuration (can also be changed via UI) ────────────────
JUNOS_HOST=192.168.1.1
JUNOS_USER=api_user
JUNOS_PASS=secure_password
JUNOS_PORT=830

# ── Authentication & Security ────────────────────────────────────────────────
# IMPORTANT: Generate a secure 64-character random string for production!
# e.g.: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_secure_random_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin Account (Auto-created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@JupeTrack2024

# Optional: Protect the initial /api/v1/auth/init admin creation endpoint
# Leaves the endpoint open if empty, requires this secret payload if set.
INIT_SECRET=

# ── Database Storage ─────────────────────────────────────────────────────────
# Options: "sqlite" (default local file) or "mysql" (for heavy production usage)
DB_TYPE=sqlite

# ── MySQL Settings (Only used if DB_TYPE=mysql) ──────────────────────────────
# Ensure docker-compose is started with `--profile mysql` if using docker
# MYSQL_USER=jupetrack
# MYSQL_PASSWORD=jupetrack_pass
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DB=jupetrack

# ── Docker External Communication ────────────────────────────────────────────
# Only needed if you run the frontend independently of the Docker setup
# INTERNAL_API_URL=http://jupetrack:3041
